PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/vgv_connect
# Obligatorio en todos los entornos: mínimo 32 bytes UTF-8. No existe valor de respaldo.
# Generar localmente: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Configurar el valor de forma privada y nunca commitearlo. Cambiarlo invalida los tokens existentes.
JWT_SECRET=
NODE_ENV=development
# Los usuarios demo se crean al arrancar SOLO con el valor exacto true, fuera de producción
# y con la base sin usuarios. El login nunca crea usuarios. No activar en despliegues reales.
ENABLE_DEMO_USERS=false
# npm run db:seed está bloqueado en producción y no modifica usuarios existentes.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
MAX_PHOTO_BYTES=5242880
CORS_ORIGINS=http://localhost:5173
# Saltos de proxy confiables para obtener la IP real (limitador de login). Vacío = no confiar.
# Detrás de un único proxy (p. ej. Railway) usar 1. No usar true: permitiría falsificar X-Forwarded-For.
TRUST_PROXY=